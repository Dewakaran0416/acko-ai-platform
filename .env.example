# Copy this file to .env and fill in YOUR values. The real .env is never committed to Git.
# Real environment variables (your Windows settings, or the EC2 server) win over this file.

# Gemini key from https://aistudio.google.com/apikey  (never put a real key in this example file)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Manager login for the dashboard and the manager assistant - choose your own password
MANAGER_PASSWORD=

# Database: leave DB_HOST empty to use SQLite on your PC. Fill these in to use PostgreSQL on AWS RDS.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require

# AWS (used from Module 3 onwards). Leave S3_BUCKET empty to keep the claim files in the folder uploads/ on your PC.
AWS_REGION=ap-southeast-2
S3_BUCKET=
# Only on your own PC: the name of the saved access key. python -m scripts.aws_setup keys adds this line for you.
# Do not add it on the EC2 server: there the IAM role of the server is used and no key exists anywhere.
# AWS_PROFILE=acko-dev

# The AWS server only (set in the server's own settings, not on your PC): fetch the trained models from Amazon S3 when the app starts.
# MODELS_FROM_S3=true
